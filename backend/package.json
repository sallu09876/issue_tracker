{
  "name": "issue-tracker-backend",
  "version": "1.0.0",
  "description": "Issue Management Platform - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
